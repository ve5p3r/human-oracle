{
  "name": "human-oracle",
  "version": "2.0.0",
  "type": "module",
  "description": "On-chain oracle for verified human knowledge from Stack Overflow and Reddit",
  "scripts": {
    "start": "node api/server.js",
    "scrape": "node scrapers/stackoverflow.js && node scrapers/reddit.js",
    "ingest": "bash scripts/ingest.sh",
    "compile": "npx hardhat compile",
    "deploy": "npx hardhat run scripts/deploy.cjs --network baseSepolia",
    "seed": "npx hardhat run scripts/seed-answers.cjs --network baseSepolia",
    "test": "npx hardhat test"
  },
  "dependencies": {
    "@coinbase/x402": "^2.1.0",
    "@openzeppelin/contracts": "^5.1.0",
    "axios": "^1.7.0",
    "dotenv": "^16.4.0",
    "express": "^5.2.1",
    "x402-express": "^1.1.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.0"
  }
}

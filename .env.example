# Required to deploy / seed the contract
PRIVATE_KEY=0xYourPrivateKeyHere

# Optional — defaults work for Base Sepolia
RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=

# API server settings (optional)
PORT=3847
PAYTO_ADDRESS=0xYourWalletAddress
X402_NETWORK=base-sepolia

# Path to QMD binary (optional, defaults to 'qmd' in PATH)
QMD_PATH=qmd

# Data directory (optional, defaults to ./data)
DATA_DIR=
